# Gmail account used to send contact/booking notifications.
# EMAIL_PASS must be a Google "App password" (Google Account → Security →
# 2-Step Verification → App passwords), never the real account password.
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Public URL of the deployed site, without a trailing slash.
# Used for canonical/Open Graph URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.example.com
